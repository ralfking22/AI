<section id="hero-{{ section.id }}" class="hero-split">
  <div class="page-width hero-split__inner">
    <div class="hero-split__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero-split__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="hero-split__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="hero-split__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: '/collections/all' }}" class="button rd-button--ball">
            {{- section.settings.button_label_1 | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '/collections/all' }}" class="button rd-button--ghost">
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="hero-split__perks">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="hero-split__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            widths: '650, 900, 1200, 1600, 2000',
            sizes: '(min-width: 990px) 68vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero (image à côté)",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Raquettes · Grips · Sacs" },
    { "type": "inline_richtext", "id": "heading", "label": "Titre (mettre en italique le mot à surligner en jaune)", "default": "Conçu pour le <em>prochain point.</em>" },
    { "type": "text", "id": "text", "label": "Texte" },
    { "type": "text", "id": "button_label_1", "label": "Bouton 1", "default": "Voir les raquettes" },
    { "type": "url", "id": "button_link_1", "label": "Lien bouton 1" },
    { "type": "text", "id": "button_label_2", "label": "Bouton 2", "default": "Tout découvrir" },
    { "type": "url", "id": "button_link_2", "label": "Lien bouton 2" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Avantage",
      "limit": 4,
      "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "Livraison mondiale" }]
    }
  ],
  "presets": [{ "name": "Hero (image à côté)" }]
}
{% endschema %}

