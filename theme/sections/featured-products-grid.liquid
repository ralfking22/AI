{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .section-{{ section.id }}-padding .featured-grid__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.6rem;
    flex-wrap: wrap;
    margin-bottom: 2.4rem;
  }
  .section-{{ section.id }}-padding .featured-grid__header h2 {
    margin: 0;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign collection_to_display = section.settings.collection | default: collections.all -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="featured-grid__header">
      {%- if section.settings.title != blank -%}
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ collection_to_display.url }}" class="link underlined-link">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <ul class="grid product-grid grid--2-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop" role="list">
      {%- for product in collection_to_display.products limit: section.settings.products_to_show -%}
        <li class="grid__item">
          {% render 'card-product',
            card_product: product,
            media_aspect_ratio: 'square',
            image_shape: 'default',
            show_secondary_image: true,
            show_vendor: false,
            show_rating: false,
            lazy_load: true,
            show_quick_add: false,
            section_id: section.id
          %}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Grille de produits",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos raquettes" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Taille du titre",
      "options": [
        { "value": "h2", "label": "Petit" },
        { "value": "h1", "label": "Moyen" },
        { "value": "h0", "label": "Grand" }
      ],
      "default": "h1"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "link_label", "label": "Texte du lien", "default": "Voir tout" },
    { "type": "range", "id": "products_to_show", "label": "Nombre de produits", "min": 2, "max": 12, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_desktop", "label": "Colonnes (ordinateur)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Marge haute", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Marge basse", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Grille de produits" }]
}
{% endschema %}
