<section id="trust-{{ section.id }}" class="trust-strip">
  <div class="page-width trust__grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="trust__item" {{ block.shopify_attributes }}>
      {%- else -%}
        <div class="trust__item" {{ block.shopify_attributes }}>
      {%- endif -%}
      <span class="trust__icon"><svg viewBox="0 0 32 32" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
{% case block.settings.icon %}
{% when 'local_shipping' %}<path d="M3 7h17v15H3zM20 12h5l4 5v5h-9"/><circle cx="9" cy="24" r="3"/><circle cx="24" cy="24" r="3"/>
{% when 'autorenew' %}<path d="M26 12A11 11 0 0 0 6 8l-3 4m0-7v7h7M6 20a11 11 0 0 0 20 4l3-4m0 7v-7h-7"/>
{% when 'lock' %}<rect x="6" y="13" width="20" height="15" rx="2"/><path d="M10 13V9a6 6 0 0 1 12 0v4M16 19v4"/>
{% else %}<path d="M5 5h22v17H13l-8 6zM10 11h12M10 16h8"/>
{% endcase %}</svg></span>
      <div>
        <p class="trust__title">{{ block.settings.title | escape }}</p>
        <p class="trust__text">{{ block.settings.text | escape }}</p>
      </div>
      {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bandeau de confiance",
  "tag": "div",
  "class": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icône (nom Material Symbols)", "default": "local_shipping" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Bandeau de confiance" }]
}
{% endschema %}

