{%- style -%}
  #trust-{{ section.id }} {
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.08);
  }
  #trust-{{ section.id }} .trust__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 3.2rem 0;
  }
  #trust-{{ section.id }} .trust__item {
    display: flex;
    gap: 1.6rem;
    align-items: flex-start;
    color: inherit;
    text-decoration: none;
  }
  #trust-{{ section.id }} .trust__icon {
    flex: none;
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 1.4rem;
    background: var(--rd-mist);
    color: var(--rd-navy);
    display: grid;
    place-items: center;
  }
  #trust-{{ section.id }} .trust__title {
    font-weight: 700;
    margin: 0 0 0.2rem;
    font-size: 1.6rem;
    color: rgb(var(--color-foreground));
  }
  #trust-{{ section.id }} .trust__text {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
    color: rgba(var(--color-foreground), 0.7);
  }
  @media screen and (min-width: 750px) {
    #trust-{{ section.id }} .trust__grid {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
      gap: 3.2rem;
      padding: 4rem 0;
    }
  }
{%- endstyle -%}

<section id="trust-{{ section.id }}" class="trust-strip">
  <div class="page-width trust__grid">
    {%- for block in section.blocks -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="trust__item" {{ block.shopify_attributes }}>
      {%- else -%}
        <div class="trust__item" {{ block.shopify_attributes }}>
      {%- endif -%}
      <span class="trust__icon">{% render 'material-icon', icon: block.settings.icon %}</span>
      <span>
        <p class="trust__title">{{ block.settings.title | escape }}</p>
        <p class="trust__text">{{ block.settings.text | escape }}</p>
      </span>
      {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Bandeau de confiance",
  "tag": "div",
  "class": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "icon", "label": "Icône (nom Material Symbols)", "default": "local_shipping" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Bandeau de confiance" }]
}
{% endschema %}
