{%- liquid
  assign rd_show = true
  if section.settings.show_on != blank and collection
    assign rd_handles = section.settings.show_on | remove: ' ' | split: ','
    unless rd_handles contains collection.handle
      assign rd_show = false
    endunless
  endif
-%}
{%- if rd_show -%}
<section id="tiles-{{ section.id }}" class="category-tiles">
  <div class="page-width">
    <div class="tiles__head">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="tiles__grid">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a href="{{ c.url | default: '/collections/all' }}" class="tile" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- if img != blank -%}
            {{ img | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: block.settings.title }}
          {%- endif -%}
          <div class="tile__body">
            <div>
              <h3 class="tile__title">{{ block.settings.title | escape }}</h3>
              <p class="tile__text">{{ block.settings.text | escape }}</p>
            </div>
            <span class="tile__arrow" aria-hidden="true">→</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- endif -%}
{% schema %}
{
  "name": "Tuiles catégories",
  "tag": "div",
  "class": "section",
  "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Acheter par catégorie" }, { "type": "text", "id": "show_on", "label": "On collection pages, show only on (handles, comma-separated)" }],
  "blocks": [
    {
      "type": "tile",
      "name": "Catégorie",
      "limit": 4,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "Tuiles catégories" }]
}
{% endschema %}

