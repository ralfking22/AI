{%- liquid
  assign rd_show = true
  if section.settings.show_on != blank and collection
    assign rd_handles = section.settings.show_on | remove: ' ' | split: ','
    unless rd_handles contains collection.handle
      assign rd_show = false
    endunless
  endif
-%}
{%- if rd_show -%}
<section id="finder-{{ section.id }}" class="racket-finder color-scheme-1">
  <div class="page-width">
    <div class="finder__head">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <div class="finder__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <a href="{{ p.url }}" class="finder__card" {{ block.shopify_attributes }}>
            <span class="finder__badge">{{ block.settings.badge | escape }}</span>
            <div class="finder__img">
              {%- if p.featured_media -%}
                {{ p.featured_media | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 750px) 30vw, 90vw', loading: 'lazy', alt: p.title }}
              {%- endif -%}
            </div>
            <h3>{{ p.title | escape }}</h3>
            <p class="finder__for">{{ block.settings.best_for | escape }}</p>
            <dl>
              {%- if block.settings.shape != blank -%}<dt>Shape</dt><dd>{{ block.settings.shape | escape }}</dd>{%- endif -%}
              {%- if block.settings.weight != blank -%}<dt>Weight</dt><dd>{{ block.settings.weight | escape }}</dd>{%- endif -%}
              {%- if block.settings.face != blank -%}<dt>Face</dt><dd>{{ block.settings.face | escape }}</dd>{%- endif -%}
            </dl>
            <div class="finder__foot">
              <span class="finder__price">{{ p.price | money }}</span>
              <span class="finder__cta">View racket →</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- endif -%}
{% schema %}
{
  "name": "Guide des raquettes",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Quelle raquette pour votre jeu ?" },
    { "type": "text", "id": "text", "label": "Texte" },
    { "type": "text", "id": "show_on", "label": "On collection pages, show only on (handles, comma-separated)" }
  ],
  "blocks": [
    {
      "type": "racket",
      "name": "Raquette",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Puissance" },
        { "type": "text", "id": "best_for", "label": "Pour qui" },
        { "type": "text", "id": "shape", "label": "Forme" },
        { "type": "text", "id": "weight", "label": "Poids" },
        { "type": "text", "id": "face", "label": "Surface" }
      ]
    }
  ],
  "presets": [{ "name": "Guide des raquettes" }]
}
{% endschema %}

