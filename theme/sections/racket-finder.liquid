{%- liquid
  assign rd_show = true
  if section.settings.show_on != blank and collection
    assign rd_handles = section.settings.show_on | remove: ' ' | split: ','
    unless rd_handles contains collection.handle
      assign rd_show = false
    endunless
  endif
-%}
{%- if rd_show -%}
{%- style -%}
  #finder-{{ section.id }} {
    padding: 5.6rem 0;
    background: var(--rd-mist);
  }
  #finder-{{ section.id }} .finder__head {
    text-align: center;
    max-width: 64rem;
    margin: 0 auto 4rem;
  }
  #finder-{{ section.id }} .finder__head p {
    color: rgba(var(--color-foreground), 0.75);
    margin: 1.2rem 0 0;
  }
  #finder-{{ section.id }} .finder__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }
  #finder-{{ section.id }} .finder__card {
    background: #fff;
    border-radius: 2rem;
    padding: 2.4rem;
    display: flex;
    flex-direction: column;
    position: relative;
    border: 0.2rem solid transparent;
    transition: border-color 0.2s, transform 0.2s;
    text-decoration: none;
    color: inherit;
  }
  #finder-{{ section.id }} .finder__card:hover {
    border-color: var(--rd-navy);
    transform: translateY(-0.4rem);
  }
  #finder-{{ section.id }} .finder__badge {
    align-self: flex-start;
    background: var(--rd-navy);
    color: var(--rd-ball);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.6rem 1.2rem;
    border-radius: 99rem;
    margin-bottom: 1.6rem;
  }
  #finder-{{ section.id }} .finder__img {
    aspect-ratio: 1;
    margin: 0 0 1.6rem;
    background: var(--rd-mist);
    border-radius: 1.4rem;
    overflow: hidden;
  }
  #finder-{{ section.id }} .finder__img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  #finder-{{ section.id }} .finder__card h3 {
    margin: 0 0 0.4rem;
    font-size: 2.2rem;
  }
  #finder-{{ section.id }} .finder__for {
    margin: 0 0 1.6rem;
    color: rgba(var(--color-foreground), 0.75);
    font-size: 1.5rem;
  }
  #finder-{{ section.id }} dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem 1.6rem;
    margin: 0 0 2rem;
    font-size: 1.4rem;
  }
  #finder-{{ section.id }} dt {
    color: rgba(var(--color-foreground), 0.6);
  }
  #finder-{{ section.id }} dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  #finder-{{ section.id }} .finder__foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.6rem;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.1);
  }
  #finder-{{ section.id }} .finder__price {
    font-size: 2rem;
    font-weight: 700;
  }
  #finder-{{ section.id }} .finder__cta {
    font-weight: 600;
    font-size: 1.4rem;
  }
  @media screen and (min-width: 750px) {
    #finder-{{ section.id }} {
      padding: 8rem 0;
    }
    #finder-{{ section.id }} .finder__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.4rem;
    }
  }
{%- endstyle -%}

<section id="finder-{{ section.id }}" class="racket-finder color-scheme-1">
  <div class="page-width">
    <div class="finder__head">
      <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <div class="finder__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <a href="{{ p.url }}" class="finder__card" {{ block.shopify_attributes }}>
            <span class="finder__badge">{{ block.settings.badge | escape }}</span>
            <div class="finder__img">
              {%- if p.featured_media -%}
                {{ p.featured_media | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(min-width: 750px) 30vw, 90vw', loading: 'lazy', alt: p.title }}
              {%- endif -%}
            </div>
            <h3>{{ p.title | escape }}</h3>
            <p class="finder__for">{{ block.settings.best_for | escape }}</p>
            <dl>
              {%- if block.settings.shape != blank -%}<dt>Shape</dt><dd>{{ block.settings.shape | escape }}</dd>{%- endif -%}
              {%- if block.settings.weight != blank -%}<dt>Weight</dt><dd>{{ block.settings.weight | escape }}</dd>{%- endif -%}
              {%- if block.settings.face != blank -%}<dt>Face</dt><dd>{{ block.settings.face | escape }}</dd>{%- endif -%}
            </dl>
            <div class="finder__foot">
              <span class="finder__price">{{ p.price | money }}</span>
              <span class="finder__cta">View racket →</span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- endif -%}
{% schema %}
{
  "name": "Guide des raquettes",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Quelle raquette pour votre jeu ?" },
    { "type": "text", "id": "text", "label": "Texte" },
    { "type": "text", "id": "show_on", "label": "On collection pages, show only on (handles, comma-separated)" }
  ],
  "blocks": [
    {
      "type": "racket",
      "name": "Raquette",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Produit" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Puissance" },
        { "type": "text", "id": "best_for", "label": "Pour qui" },
        { "type": "text", "id": "shape", "label": "Forme" },
        { "type": "text", "id": "weight", "label": "Poids" },
        { "type": "text", "id": "face", "label": "Surface" }
      ]
    }
  ],
  "presets": [{ "name": "Guide des raquettes" }]
}
{% endschema %}
